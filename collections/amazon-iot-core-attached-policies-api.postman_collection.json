          "request": {
            "name": "Amazon IoT Core List Attached Policies",
            "description": {
              "content": "<p>Lists the policies attached to the specified thing group.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">ListAttachedPolicies</a> action.</p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "attached-policies",
                ":target"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "recursive",
                  "value": "<boolean>",
                  "description": "When true, recursively list attached policies."
                },
                {
                  "disabled": false,
                  "key": "marker",
                  "value": "<string>",
                  "description": "The token to retrieve the next set of results."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "The maximum number of results to be returned per request."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "target",
                  "description": "(Required) The group or principal for which the policies will be listed. Valid principals are CertificateArn (arn:aws:iot:<i>region</i>:<i>accountId</i>:cert/<i>certificateId</i>), thingGroupArn (arn:aws:iot:<i>region</i>:<i>accountId</i>:thinggroup/<i>groupName</i>) and CognitoId (<i>region</i>:<i>id</i>)."
                },
                {
                  "description": "The AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,us-gov-west-1,us-gov-east-1,ca-central-1,eu-north-1,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-south-1,af-south-1,ap-northeast-1,ap-northeast-2,ap-northeast-3,ap-southeast-1,ap-southeast-2,ap-east-1,ap-south-1,sa-east-1,me-south-1)",
