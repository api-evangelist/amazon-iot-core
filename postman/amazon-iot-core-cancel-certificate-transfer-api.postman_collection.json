              "name": "Amazon IoT Core Cancel Certificate Transfer",
              "id": "de1b7a4e-8984-4a95-a104-9d8367d63c57",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PATCH",
